{"id":"chatcmpl-b7943860cc552183","object":"chat.completion","created":1795303640,"model":"p2-graph-20261121T230225Z","choices":[{"index":0,"message":{"role":"assistant","content":"```python\ndef min_window(text, pattern):\n    if not pattern or not text:\n        return \"\"\n    need = {}\n    for ch in pattern:\n        need[ch] = need.get(ch, 0) + 1\n    required = len(need)\n    formed = 0\n    window_counts = {}\n    left = 0\n    best_len = float('inf')\n    best_left = 0\n    for right, ch in enumerate(text):\n        window_counts[ch] = window_counts.get(ch, 0) + 1\n        if ch in need and window_counts[ch] == need[ch]:\n            formed += 1\n        while left <= right and formed == required:\n            if right - left + 1 < best_len:\n                best_len = right - left + 1\n                best_left = left\n            left_ch = text[left]\n            window_counts[left_ch] -= 1\n            if left_ch in need and window_counts[left_ch] < need[left_ch]:\n                formed -= 1\n            left += 1\n    if best_len == float('inf'):\n        return \"\"\n    return text[best_left:best_left + best_len]\n```","refusal":null,"annotations":null,"audio":null,"function_call":null,"reasoning":null},"logprobs":null,"finish_reason":"stop","stop_reason":null,"token_ids":null,"routed_experts":null}],"service_tier":null,"system_fingerprint":"vllm-0.27.1-tp8-ep-29f225ee","usage":{"prompt_tokens":153,"total_tokens":402,"completion_tokens":249,"prompt_tokens_details":null},"prompt_logprobs":null,"prompt_token_ids":null,"prompt_text":null,"kv_transfer_params":null,"ec_transfer_params":null,"metrics":null}