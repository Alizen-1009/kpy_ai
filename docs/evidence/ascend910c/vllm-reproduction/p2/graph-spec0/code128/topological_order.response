{"id":"chatcmpl-8456fdfb8c93149e","object":"chat.completion","created":1795303626,"model":"p2-graph-20261121T230225Z","choices":[{"index":0,"message":{"role":"assistant","content":"```python\nimport heapq\n\ndef topological_order(nodes, edges):\n    node_set = set(nodes)\n    adj = {node: set() for node in nodes}\n    indeg = {node: 0 for node in nodes}\n    \n    for u, v in edges:\n        if u in node_set and v in node_set and v not in adj[u]:\n            adj[u].add(v)\n            indeg[v] += 1\n    \n    heap = [node for node in nodes if indeg[node] == 0]\n    heapq.heapify(heap)\n    \n    result = []\n    while heap:\n        u = heapq.heappop(heap)\n        result.append(u)\n        for v in adj[u]:\n            indeg[v] -= 1\n            if indeg[v] == 0:\n                heapq.heappush(heap, v)\n    \n    if len(result) != len(nodes):\n        return []\n    return result\n```","refusal":null,"annotations":null,"audio":null,"function_call":null,"reasoning":null},"logprobs":null,"finish_reason":"stop","stop_reason":null,"token_ids":null,"routed_experts":null}],"service_tier":null,"system_fingerprint":"vllm-0.27.1-tp8-ep-29f225ee","usage":{"prompt_tokens":189,"total_tokens":387,"completion_tokens":198,"prompt_tokens_details":null},"prompt_logprobs":null,"prompt_token_ids":null,"prompt_text":null,"kv_transfer_params":null,"ec_transfer_params":null,"metrics":null}