{"id":"chatcmpl-960736c2d7e31cb8","object":"chat.completion","created":1795301702,"model":"p2-8192-20261121T224721Z","choices":[{"index":0,"message":{"role":"assistant","content":"```python\ndef merge_intervals(intervals):\n    if not intervals:\n        return []\n    \n    sorted_intervals = sorted(intervals, key=lambda x: (x[0], x[1]))\n    merged = []\n    \n    for start, end in sorted_intervals:\n        if not merged or start > merged[-1][1]:\n            merged.append([start, end])\n        else:\n            if end > merged[-1][1]:\n                merged[-1][1] = end\n    \n    return merged\n```","refusal":null,"annotations":null,"audio":null,"function_call":null,"reasoning":null},"logprobs":null,"finish_reason":"stop","stop_reason":null,"token_ids":null,"routed_experts":null}],"service_tier":null,"system_fingerprint":"vllm-0.27.1-tp8-ep-35ef3be2","usage":{"prompt_tokens":174,"total_tokens":282,"completion_tokens":108,"prompt_tokens_details":null},"prompt_logprobs":null,"prompt_token_ids":null,"prompt_text":null,"kv_transfer_params":null,"ec_transfer_params":null,"metrics":null}