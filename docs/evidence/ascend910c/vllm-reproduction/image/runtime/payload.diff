+            while _bp_time.perf_counter() < end:
+                pass
+
+    def stat(self, key, t0):
+        dt = (_bp_time.perf_counter() - t0) * 1000.0
+        if self.cur_is_decode:
+            self.acc[key] = self.acc.get(key, 0.0) + dt
+        return dt
+
+    def mark_step(self):
